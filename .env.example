SECRET_KEY=django-insecure-data-analysis-dashboard-super-secure-key-2026-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Settings (Defaults to SQLite for local development, PostgreSQL ready)
USE_POSTGRES=False
DB_NAME=data_analysis_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis & Cache Settings
REDIS_URL=redis://127.0.0.1:6379/1
USE_REDIS_CACHE=False

# Celery Broker
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# JWT Auth
JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=14

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
